# App (Expo) — must be EXPO_PUBLIC_ to be readable client-side
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge Function secrets — set with `supabase secrets set`, NOT in this file.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by Supabase; you do not set them yourself.

# Push delivery (send-notification). This is the full Firebase service account
# JSON, as a single-line string — NOT a legacy "FCM server key". Google shut the
# legacy server-key API down in 2024; firebase-admin uses a service account.
# Firebase console -> Project settings -> Service accounts -> Generate new key.
FIREBASE_SERVICE_ACCOUNT_JSON=
