{
  "expo": {
    "name": "Social Credit",
    "slug": "social-credit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "socialcredit",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socialcredit.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0EAD6"
      },
      "package": "com.socialcredit.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#C20000"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F0EAD6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "A gamified household chore tracker for shared homes. Assign, complete and track domestic tasks with a playful credit system.",
    "primaryColor": "#C20000"
  }
}
